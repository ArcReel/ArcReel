    {
      "path": "frontend/src/hooks/useUnitPromptHighlight.ts",
      "comments": [
        {
          "start": 313,
          "end": 1157,
          "line": 14,
          "text": "/**\n * @mention / speech tokenizer for the reference-video unit body editor.\n *\n * Regex mirrors lib/script/reference_video/text_parser.py via reference-mentions.MENTION_RE.\n *\n * Output tokens are non-overlapping and concatenate back to the original text.\n *\n * Match raw text: tokens must reconstruct exact source over textarea overlays, so never normalize source. Only\n * `name` from `mentionNameFromMatch` is canonical. One residual case remains: BOM inside bare mentions\n * (`@张<U+FEFF>三`) is excluded by `MENTION_RE` bare-name character classes, so highlighting stops before BOM,\n * treating names as unregistered. Reference derivation uses `extractMentions` on normalized lines and is unaffected; only editor coloring\n * differs. Wrapped `@[名<U+FEFF>称]` avoids this: BOM stays inside brackets, whole names normalize after extraction.\n */"
        },
        {
          "start": 1529,
          "end": 1896,
          "line": 35,
          "text": "/**\n * `speech` represents parser-recognized utterance markers (`@[角色]{台词}` / `{台词}`). `text` always contains their entire\n * raw source (including `@[名称]` and braces), so token sequences still reconstruct source exactly; empty `speaker`\n * means voiceover. No separate dialogue-body field: rendering needs entire raw spans, with no consumer for extracted bodies.\n */"
        },
        {
          "start": 6713,
          "end": 6822,
          "line": 147,
          "text": "// Whitespace around markers is not description: `  @[张三]：{我来了}  ` is identical dialogue to unindented forms."
        }
      ]
    }
