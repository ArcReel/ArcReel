  "SourceRange": {
    "direct": {
      "additionalProperties": false,
      "description": "Episode source-material ranges spanning files in whole-source order (ADR 0097).\n\nStart at ``start`` in ``source_file``, ending exclusively at ``end`` in ``end_file``; ``end_file`` defaults to\n``source_file``. Offsets are per-file indices in ``normalize_source_text`` coordinates, exact narration splits\nor soft drama material ranges. Paths are project-relative POSIX, such as ``source/novel.txt``.\nWhole-source manifests determine file order, not validated here.",
      "properties": {
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "end_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End File"
        }
      },
      "required": [
        "source_file",
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    },
    "model_facing": {
      "additionalProperties": false,
      "properties": {
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "end_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End File"
        }
      },
      "required": [
        "source_file",
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    }
  },
