# ArcReel Generator Environment Configuration
# ArcReel generator environment configuration
#
# Copy this file to .env and fill in your values.
# Copy this file to .env and fill in your values.

# ============================================================
# Authentication configuration
# ============================================================
# Login username (default: admin)
# Login username (default: admin)
AUTH_USERNAME=admin
# Login password (leave empty to auto-generate on first launch and write back to this file)
# Login password (empty: generated on first startup and written back to this file)
AUTH_PASSWORD=
# JWT signing secret (leave empty to auto-generate and keep it in runtime/auth-token-secret
# under the data directory, so logins survive restarts; a value set here takes precedence)
# JWT signing secret (empty: generated and stored in data-root runtime/auth-token-secret, preserving logins across restarts;
# an explicit value here takes precedence)
AUTH_TOKEN_SECRET=
# Auth kill switch (default: true). Setting it to false disables login and token
# checks. Use only when an independent network boundary confines ArcReel to a
# trusted local environment.
# Authentication master switch (default true). false bypasses login/token checks; use only when an independent
# network boundary confines ArcReel to a trusted local environment.
# AUTH_ENABLED=true

# ============================================================
# Network binding
# ============================================================
# Defaults preserve current behavior. Override for tighter binding or non-default ports.
# NOTE: LISTEN_HOST / LISTEN_PORT only apply when running via `python server/app.py`
# (the __main__ entrypoint). For `uvicorn server.app:app` / Docker / systemd, pass
# host/port as uvicorn CLI args — the ASGI module cannot rebind uvicorn at import.
# Defaults match current behavior; restrict bind address/port as needed.
# LISTEN_HOST / LISTEN_PORT apply only to the `python server/app.py` entry point;
# with `uvicorn server.app:app` / Docker / systemd, supply host/port as uvicorn CLI arguments
# because the ASGI module cannot retroactively change the server process binding.
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=1241
# Comma-separated CORS origins; "*" or unset → permissive (credentials disabled
# by CORS spec). Set an explicit whitelist (e.g. "http://localhost:5173") to
# enable credentialed cross-origin requests. The remote MCP endpoint shares this
# allowlist for browser clients, so it needs no separate MCP origin variable.
# Comma-separated CORS origins; "*" or unset means wildcard (credentials disabled by the CORS specification).
# Only allowlists (e.g. "http://localhost:5173") enable cross-origin credentials. Browser remote-MCP clients
# share this allowlist; no separate MCP origin variable is needed.
# CORS_ORIGINS=*

# ============================================================
# Application data root
# ============================================================
# Where projects, generated assets, SQLite DB live. Unset → PROJECT_ROOT/projects
# (current behavior). Set to redirect data to an external location.
# Root for projects/generated artifacts/SQLite DB. Unset uses PROJECT_ROOT/projects as before.
# Set to redirect data to any directory.
# ARCREEL_DATA_DIR=

# Path to agent_runtime_profile dir (contains .claude/ and CLAUDE.md). Default:
# PROJECT_ROOT/agent_runtime_profile. Set when the profile lives outside the
# source tree so it does not need to be a sibling of the projects root.
# agent_runtime_profile path, containing .claude/ and CLAUDE.md. Default:
# PROJECT_ROOT/agent_runtime_profile. Configure when profiles live outside the source tree.
# ARCREEL_PROFILE_DIR=

# ============================================================
# Official service
# ============================================================
# Market install counts, ratings and submissions come from the ArcReel official service.
# Unset → the built-in address. Set to empty to turn the official service off entirely:
# the market page shows none of its elements and the server sends it no requests.
# Users can also turn it off in Settings › About.
# Market installation counts, ratings, and sharing submissions come from the official ArcReel service. Unset uses the built-in URL;
# empty disables it entirely: no service UI elements or local-server requests. Users may also disable it in Settings › About.
# ARCREEL_OFFICIAL_SERVICE_URL=

# ============================================================
# Database configuration
# ============================================================
# Default: SQLite (for development / single-machine deployment)
# SQLite by default, for development/single-machine use.
# SQLite:     sqlite+aiosqlite:///./projects/arcreel.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/arcreel
# DATABASE_URL=sqlite+aiosqlite:///./projects/arcreel.db

# ============================================================
# Agent session store
# ============================================================
# Mirror Claude Agent SDK session transcripts to the project DB (default db).
# off switches back to SDK local jsonl within 5 seconds, skipping startup migration and DB mirroring.
# Controls whether Claude Agent SDK transcripts are mirrored into the project DB
# (default: db). Set to off to instantly roll back to SDK's filesystem path —
# skips startup migration and the DbSessionStore wiring.
# ARCREEL_SDK_SESSION_STORE=db

# ============================================================
# Logging
# ============================================================
# Log level (default: INFO, options: DEBUG, WARNING, ERROR)
# Log level (default INFO; options DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO

# Disable file logging (default: false). When set to 1/true/yes, logs go only to stdout.
# Disable file logging (default false). 1/true/yes sends logs only to stdout.
# ARCREEL_LOG_FILE_DISABLED=

# ============================================================
# Timezone
# ============================================================
# IANA timezone for the container's system clock (used by Docker compose).
# Default: Asia/Shanghai. Common values: Asia/Tokyo, America/Los_Angeles, UTC.
# Container timezone, injected by docker-compose; default Asia/Shanghai.
# Common values: Asia/Tokyo, America/Los_Angeles, UTC.
# TZ=Asia/Shanghai
