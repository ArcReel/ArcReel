{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // 一次性迁移脚本由人工按需运行，没有 package.json 入口
  "entry": ["scripts/*.ts"],
  "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts", "scripts/**/*.ts", "*.{ts,js}"],
  "ignoreBinaries": ["uv"],
  "ignoreExportsUsedInFile": true,
  // shadcn 原语模块按成套 API 导出子组件（如 TooltipTrigger、DialogFooter），暂无调用方也要保留，
  // 否则下次 `shadcn add --diff` 合并上游时会被当作本地删改。只豁免导出类问题；
  // 未使用的原语文件与依赖照常报告，组件按需安装。
  "ignoreIssues": {
    "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"]
  }
}
