{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts", "*.{ts,js}"],
  "ignoreBinaries": ["uv"],
  "ignoreExportsUsedInFile": true,
  // shadcn primitive modules export complete subcomponent APIs (e.g. TooltipTrigger, DialogFooter); retain unused exports,
  // or the next upstream merge through `shadcn add --diff` treats them as local deletions/edits. Exempt export issues only;
  // unused primitive files and dependencies are still reported; install components on demand.
  "ignoreIssues": {
    "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"]
  }
}
