# ArcReel production environment (PostgreSQL)
# Copy to .env and fill in your values.

# ============================================================
# Authentication
# ============================================================
# Login username (default: admin)
AUTH_USERNAME=admin
# Login password (empty: generated on first startup and written back to .env)
# After edits, run docker compose up -d to recreate containers; docker compose restart does not reload values.
AUTH_PASSWORD=
# JWT signing secret (empty: generated in projects/runtime/auth-token-secret, preserving logins across restarts;
# an explicit value here takes precedence)
AUTH_TOKEN_SECRET=

# ============================================================
# PostgreSQL configuration
# ============================================================
# Database password, required and validated by docker-compose startup.
# Use alphanumeric characters only; URL specials (@#/?%, etc.) can break DATABASE_URL parsing.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ============================================================
# Logging
# ============================================================
# Log level (default INFO; options DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO
