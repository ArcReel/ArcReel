{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets baseUrl in compilerOptions; TypeScript 6.0
    // deprecates that option (TS5101), so typecheck fails without an explicit exemption.
    "ignoreDeprecations": "6.0"
  },
  "exclude": [".docusaurus", "build"]
}
