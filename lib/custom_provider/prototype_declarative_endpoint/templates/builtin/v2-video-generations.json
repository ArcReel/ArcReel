{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "流派 C /v2/video/generations（内置复刻）",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "复刻 lib/video_backends/v2_video_generations.py：POST {root}/v2/video/generations → GET {root}/v2/video/generations?generation_id=。请求体为各家公共子集，素材 data URI 内嵌；task_id / status / 视频地址各用一张多路径优先级表。内置在无参考图时不写 image_urls 键，格式的 $each 展开为空时留下空数组。",
    "hints": {
      "base_url": "https://api.aimlapi.com",
      "suggested_models": [
        {
          "id": "seedance-1.0"
        }
      ]
    }
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "first_frame": {
      "source": "start_image",
      "encoding": "data_uri"
    },
    "last_frame": {
      "source": "end_image",
      "encoding": "data_uri"
    },
    "refs": {
      "source": "reference_images",
      "encoding": "data_uri"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v2/video/generations",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "duration": "{{ duration }}",
      "aspect_ratio": "{{ aspect_ratio }}",
      "resolution": "{{ resolution }}",
      "seed": "{{ seed }}",
      "image_url": "{{ inputs.first_frame }}",
      "last_image_url": "{{ inputs.last_frame }}",
      "image_urls": [
        {
          "$each": {
            "in": "inputs.refs",
            "as": "r",
            "item": "{{ r }}"
          }
        }
      ]
    },
    "extract": {
      "task_id": {
        "paths": [
          "$.generation_id",
          "$.id",
          "$.task_id",
          "$.data.task_id",
          "$.request_id",
          "$.data.taskId"
        ],
        "accept": "scalar"
      },
      "error": [
        "$.error.message",
        "$.error.name",
        "$.error",
        "$.message"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v2/video/generations?generation_id={{ task_id }}",
    "extract": {
      "status": [
        "$.status",
        "$.state",
        "$.data.status",
        "$.data.state",
        "$.output.status"
      ],
      "video_url": [
        "$.video.url",
        "$.assets.video",
        "$.output.video_url",
        "$.content.video_url",
        "$.data.task_result.videos[0].url",
        "$.url"
      ],
      "error": [
        "$.error.message",
        "$.error.name",
        "$.error",
        "$.data.error.message",
        "$.data.error.name",
        "$.data.error"
      ]
    }
  },
  "status_map": {
    "expired": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "last_frame": true,
    "max_reference_images": 4,
    "audio_track": "controllable"
  }
}
