{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax S2V-01 单脸参考生视频（v1，内置复刻）",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "同海螺 v1 链路；请求体只有 model / prompt / subject_reference=[{type:character, image:[参考图]}]，不下发 resolution / duration。内置只取 reference_images[0]，格式经 $each 展开全部参考图，上限由 capabilities.max_reference_images=1 在编排层裁剪。",
    "hints": {
      "base_url": "https://api.minimaxi.com/v1",
      "suggested_models": [
        {
          "id": "S2V-01"
        }
      ]
    }
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "refs": {
      "source": "reference_images",
      "encoding": "data_uri"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/video_generation",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "subject_reference": [
        {
          "type": "character",
          "image": [
            {
              "$each": {
                "in": "inputs.refs",
                "as": "r",
                "item": "{{ r }}"
              }
            }
          ]
        }
      ]
    },
    "extract": {
      "task_id": [
        "$.task_id"
      ],
      "error": [
        "$.base_resp.status_msg"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/query/video_generation?task_id={{ task_id }}",
    "extract": {
      "status": [
        "$.status"
      ],
      "video_url": [
        "$.file.download_url"
      ],
      "error": [
        "$.base_resp.status_msg"
      ]
    }
  },
  "status_map": {
    "preparing": "queued",
    "queueing": "queued",
    "processing": "running",
    "success": "succeeded",
    "fail": "failed"
  },
  "capabilities": {
    "first_frame": false,
    "max_reference_images": 1,
    "audio_track": "always_off"
  }
}
