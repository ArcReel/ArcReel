{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "DashScope 万相 2.7 参考生视频（内置复刻）",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "复刻 lib/video_backends/dashscope.py 的 POST /api/v1/services/aigc/video-generation/video-synthesis（X-DashScope-Async: enable）→ GET /api/v1/tasks/{id}。 wan2.7-r2v 可同时带首帧与参考图；参考音频须按 reference_audio_targets 逐段挂到对应参考项的 reference_voice 字段——格式没有「按下标把两个列表配对」的构造，本定义不下发参考音频。首帧在场时内置不下发 ratio，本定义按首帧路径省略 ratio。",
    "hints": {
      "base_url": "https://dashscope.aliyuncs.com/api/v1",
      "suggested_models": [
        {
          "id": "wan2.7-r2v"
        }
      ]
    }
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "first_frame": {
      "source": "start_image",
      "encoding": "data_uri"
    },
    "refs": {
      "source": "reference_images",
      "encoding": "data_uri"
    }
  },
  "enum_maps": {
    "resolution": {
      "480p": "480P",
      "720p": "720P",
      "1080p": "1080P"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/services/aigc/video-generation/video-synthesis",
    "headers": {
      "X-DashScope-Async": "enable"
    },
    "body": {
      "model": "{{ model }}",
      "input": {
        "prompt": "{{ prompt }}",
        "media": [
          {
            "type": "first_frame",
            "url": "{{ inputs.first_frame }}"
          },
          {
            "$each": {
              "in": "inputs.refs",
              "as": "r",
              "item": {
                "type": "reference_image",
                "url": "{{ r }}"
              }
            }
          }
        ]
      },
      "parameters": {
        "resolution": "{{ resolution }}",
        "duration": "{{ duration }}",
        "watermark": false,
        "seed": "{{ seed }}"
      }
    },
    "extract": {
      "task_id": [
        "$.output.task_id"
      ],
      "error": [
        "$.message",
        "$.code"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/tasks/{{ task_id }}",
    "extract": {
      "status": [
        "$.output.task_status"
      ],
      "video_url": [
        "$.output.video_url"
      ],
      "error": [
        "$.output.message",
        "$.output.code",
        "$.message",
        "$.code"
      ],
      "usage": {
        "duration": {
          "paths": [
            "$.usage.duration"
          ],
          "accept": "scalar"
        }
      }
    }
  },
  "status_map": {
    "pending": "queued",
    "running": "running",
    "succeeded": "succeeded",
    "failed": "failed",
    "canceled": "failed",
    "unknown": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "max_reference_images": 5,
    "max_prompt_chars": 5000,
    "audio_track": "always_on"
  }
}
