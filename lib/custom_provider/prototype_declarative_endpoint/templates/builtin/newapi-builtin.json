{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "NewAPI /v1/video/generations（内置复刻）",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "复刻 lib/video_backends/newapi.py：POST {base}/video/generations → GET {base}/video/generations/{task_id}。内置下发 width / height（aspect_ratio × resolution 经 aspect_size 算出、对齐 8）与 n=1；格式无派生尺寸变量，本定义不下发 width / height。状态与视频地址按扁平 / {code,data} 包装两种形状优先级探测。expired 折进 failed（内置在 resume 路径区分）。",
    "hints": {
      "base_url": "https://your-newapi-host/v1",
      "suggested_models": [
        {
          "id": "kling-v1"
        }
      ]
    }
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "first_frame": {
      "source": "start_image",
      "encoding": "data_uri"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/video/generations",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "duration": "{{ duration }}",
      "n": 1,
      "seed": "{{ seed }}",
      "image": "{{ inputs.first_frame }}"
    },
    "extract": {
      "task_id": [
        "$.task_id"
      ],
      "error": [
        "$.error.message",
        "$.error",
        "$.message"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/video/generations/{{ task_id }}",
    "extract": {
      "status": [
        "$.status",
        "$.data.status"
      ],
      "video_url": [
        "$.url",
        "$.result_url",
        "$.data.url",
        "$.data.result_url"
      ],
      "error": [
        "$.error.message",
        "$.error.name",
        "$.error",
        "$.data.error.message",
        "$.data.error.name",
        "$.data.error"
      ],
      "usage": {
        "duration": {
          "paths": [
            "$.metadata.duration",
            "$.data.metadata.duration"
          ],
          "accept": "scalar"
        },
        "seed": {
          "paths": [
            "$.metadata.seed",
            "$.data.metadata.seed"
          ],
          "accept": "scalar"
        }
      }
    }
  },
  "status_map": {
    "expired": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "audio_track": "controllable"
  }
}
