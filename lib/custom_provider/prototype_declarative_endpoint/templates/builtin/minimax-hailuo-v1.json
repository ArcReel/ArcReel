{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax 海螺 2.3（v1，内置复刻）",
    "author": "ArcReel",
    "version": "0.1.0",
    "description": "复刻 lib/video_backends/minimax.py 的 v1 链路：POST /v1/video_generation → GET /v1/query/video_generation?task_id= 至 status=Success 取 file_id → GET /v1/files/retrieve?file_id= 取 file.download_url。格式只有提交与轮询两段请求，第三段取件不可表达：本定义的 video_url 路径在轮询响应里永远无命中。业务错误以 HTTP 200 + base_resp.status_code≠0 承载，提交阶段靠 task_id 无命中判失败，轮询阶段无法判失败。",
    "hints": {
      "base_url": "https://api.minimaxi.com/v1",
      "suggested_models": [
        {
          "id": "MiniMax-Hailuo-2.3"
        },
        {
          "id": "MiniMax-Hailuo-2.3-Fast"
        }
      ]
    }
  },
  "auth": {
    "headers": {
      "Authorization": "Bearer {{ api_key }}"
    }
  },
  "inputs": {
    "first_frame": {
      "source": "start_image",
      "encoding": "data_uri"
    }
  },
  "enum_maps": {
    "resolution": {
      "768p": "768P",
      "1080p": "1080P"
    }
  },
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/video_generation",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "duration": "{{ duration }}",
      "resolution": "{{ resolution }}",
      "first_frame_image": "{{ inputs.first_frame }}"
    },
    "extract": {
      "task_id": [
        "$.task_id"
      ],
      "error": [
        "$.base_resp.status_msg"
      ]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/query/video_generation?task_id={{ task_id }}",
    "extract": {
      "status": [
        "$.status"
      ],
      "video_url": [
        "$.file.download_url"
      ],
      "error": [
        "$.base_resp.status_msg"
      ]
    }
  },
  "status_map": {
    "preparing": "queued",
    "queueing": "queued",
    "processing": "running",
    "success": "succeeded",
    "fail": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "audio_track": "always_off"
  }
}
