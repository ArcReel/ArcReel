{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {"name": "DreamAPI DreamImage 2.0", "author": "ArcReel", "version": "1.0.0", "description": "DreamImage 2.0 image editing from a source image and prompt.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "dreamimage-2.0"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"image": {"source": "first_reference_image", "encoding": "dreamapi_url", "required": true}},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/dreamimage_2.0", "body": {"image": "{{ inputs.image }}", "prompt": "{{ prompt }}"}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "image_url": ["$.data.images[0].imageUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"image_to_image": true, "max_reference_images": 1}
}
