{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax H3",
    "author": "ArcReel",
    "version": "1.0.0",
    "hints": {"suggested_models": [{"id": "MiniMax-H3"}]}
  },
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {
    "first_frame": {"source": "start_image", "encoding": "data_uri"},
    "last_frame": {"source": "end_image", "encoding": "data_uri"},
    "refs": {"source": "reference_images", "encoding": "data_uri"},
    "ref_audio": {"source": "reference_audio_files", "encoding": "data_uri"}
  },
  "enum_maps": {"resolution": {"768p": "768P", "2k": "2K"}},
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v2/video_generation",
    "body": {
      "model": "{{ model }}",
      "content": [
        {"type": "text", "text": "{{ prompt }}"},
        {
          "$when": "first_frame",
          "type": "image_url",
          "image_url": {"url": "{{ inputs.first_frame }}"},
          "role": "first_frame"
        },
        {
          "$when": "last_frame",
          "type": "image_url",
          "image_url": {"url": "{{ inputs.last_frame }}"},
          "role": "last_frame"
        },
        {
          "$each": {
            "in": "inputs.refs",
            "as": "ref",
            "item": {"type": "image_url", "image_url": {"url": "{{ ref }}"}, "role": "reference_image"}
          }
        },
        {
          "$each": {
            "in": "inputs.ref_audio",
            "as": "audio",
            "item": {"type": "audio_url", "audio_url": {"url": "{{ audio }}"}, "role": "reference_audio"}
          }
        }
      ],
      "resolution": "{{ resolution }}",
      "duration": "{{ duration }}",
      "ratio": "{{ aspect_ratio }}"
    },
    "extract": {"task_id": ["$.task_id"], "error": ["$.base_resp.status_msg"]}
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v2/query/video_generation/{{ task_id }}",
    "extract": {
      "status": ["$.task.status"],
      "video_url": ["$.task.content.url"],
      "error": ["$.task.error", "$.task.status_msg", "$.base_resp.status_msg"],
      "failure": ["$[?@.status_code && @.status_code != 0].status_msg"]
    }
  },
  "status_map": {
    "queued": "queued",
    "running": "running",
    "succeeded": "succeeded",
    "failed": "failed",
    "cancelled": "failed"
  },
  "capabilities": {
    "first_frame": true,
    "last_frame": true,
    "max_reference_images": 9,
    "reference_audio_mode": "direct",
    "max_reference_audio_count": 3,
    "max_reference_audio_total_seconds": 15,
    "max_prompt_chars": 7000,
    "first_frame_ratio_adaptive_only": true,
    "audio_track": "always_on"
  }
}
