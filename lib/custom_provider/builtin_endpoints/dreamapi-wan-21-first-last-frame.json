{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "meta": {"name": "DreamAPI Wan 2.1 First and Last Frame", "author": "ArcReel", "version": "1.0.0", "description": "Generate a transition between required first and last images with Wan 2.1. DreamAPI's documented request does not accept a duration parameter.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "wan-2.1"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"first_frame": {"source": "start_image", "encoding": "dreamapi_url", "required": true}, "last_frame": {"source": "end_image", "encoding": "dreamapi_url", "required": true}},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/wan/head_tail_to_video/2.1", "body": {"firstImage": "{{ inputs.first_frame }}", "lastImage": "{{ inputs.last_frame }}", "prompt": "{{ prompt }}"}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "video_url": ["$.data.videos[0].videoUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"first_frame": true, "last_frame": true, "audio_track": "always_off"}
}
