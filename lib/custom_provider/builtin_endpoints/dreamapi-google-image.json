{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {"name": "DreamAPI Nano Banana", "author": "ArcReel", "version": "1.0.0", "description": "Nano Banana 2 and Nano Banana Pro through DreamAPI.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "gemini-3.1-flash-image-preview", "label": "Nano Banana 2"}, {"id": "gemini-3-pro-image-preview", "label": "Nano Banana Pro"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"refs": {"source": "reference_images", "encoding": "dreamapi_url"}},
  "enum_maps": {"resolution": {"1K": "1K", "2K": "2K"}},
  "defaults": {"resolution": "1K"},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/google_gemini_image", "body": {"model": "{{ model }}", "text": "{{ prompt }}", "imageSize": "{{ resolution }}", "aspectRatio": "{{ aspect_ratio }}", "images": [{"$when": "refs", "$each": {"in": "inputs.refs", "as": "image", "item": "{{ image }}"}}]}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "image_url": ["$.data.images[0].imageUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"text_to_image": true, "image_to_image": true, "max_reference_images": 1}
}
