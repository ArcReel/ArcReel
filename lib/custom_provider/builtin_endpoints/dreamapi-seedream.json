{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {"name": "DreamAPI Seedream", "author": "ArcReel", "version": "1.0.0", "description": "Seedream 4.0, 4.5, 5.0 Pro and 5.0 Lite. Use the shared 2K size tier for compatibility.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "seedream-4.0"}, {"id": "seedream-4.5"}, {"id": "seedream-5.0-pro"}, {"id": "seedream-5.0-lite"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"refs": {"source": "reference_images", "encoding": "dreamapi_url"}},
  "enum_maps": {"resolution": {"2K": "2K"}},
  "defaults": {"resolution": "2K"},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/seedream", "body": {"model": "{{ model }}", "prompt": "{{ prompt }}", "size": "{{ resolution }}", "image": [{"$when": "refs", "$each": {"in": "inputs.refs", "as": "image", "item": "{{ image }}"}}], "seed": "{{ seed }}"}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "image_url": ["$.data.images[0].imageUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"text_to_image": true, "image_to_image": true, "max_reference_images": 10}
}
