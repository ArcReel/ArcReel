{
  "kind": "declarative",
  "schema_version": "1.0.0",
  "meta": {
    "name": "MiniMax S2V-01",
    "author": "ArcReel",
    "version": "1.0.0",
    "hints": {"suggested_models": [{"id": "S2V-01"}]}
  },
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"refs": {"source": "reference_images", "encoding": "data_uri", "required": true}},
  "submit": {
    "method": "POST",
    "url": "{{ base_url }}/v1/video_generation",
    "body": {
      "model": "{{ model }}",
      "prompt": "{{ prompt }}",
      "subject_reference": [
        {
          "type": "character",
          "image": [{"$each": {"in": "inputs.refs", "as": "ref", "item": "{{ ref }}"}}]
        }
      ]
    },
    "extract": {"task_id": ["$.task_id"], "error": ["$.base_resp.status_msg"]}
  },
  "poll": {
    "method": "GET",
    "url": "{{ base_url }}/v1/query/video_generation?task_id={{ task_id }}",
    "extract": {
      "status": ["$.status"],
      "error": ["$.base_resp.status_msg"],
      "failure": ["$[?@.status_code && @.status_code != 0].status_msg"],
      "result_id": {"paths": ["$.file_id"], "accept": "scalar"}
    }
  },
  "result": {
    "method": "GET",
    "url": "{{ base_url }}/v1/files/retrieve?file_id={{ result_id }}",
    "extract": {"video_url": ["$.file.download_url"], "error": ["$.base_resp.status_msg"]}
  },
  "status_map": {
    "preparing": "queued",
    "queueing": "queued",
    "processing": "running",
    "success": "succeeded",
    "fail": "failed"
  },
  "capabilities": {"max_reference_images": 1, "audio_track": "always_off"}
}
