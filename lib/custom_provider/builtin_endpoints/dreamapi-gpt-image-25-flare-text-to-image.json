{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {"name": "DreamAPI GPT Image 2.5 Flare Text to Image", "author": "ArcReel", "version": "1.0.0", "description": "GPT Image 2.5 Flare text-to-image. Use 1K or larger output sizes.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "gpt-image-2.5-flare"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "defaults": {"resolution": "1K"},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/gpt_image_2.5/flare/text_to_image", "body": {"prompt": "{{ prompt }}", "width": "{{ width }}", "height": "{{ height }}", "quality": "low", "n": 1}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "image_url": ["$.data.images[0].imageUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"text_to_image": true}
}
