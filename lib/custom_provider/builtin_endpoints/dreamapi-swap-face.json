{
  "kind": "declarative",
  "schema_version": "1.2.0",
  "media_type": "image",
  "meta": {"name": "DreamAPI Swap Face", "author": "ArcReel", "version": "1.0.0", "description": "Swap a face using ordered target and source-face reference images.", "hints": {"base_url": "https://api.newportai.com", "suggested_models": [{"id": "swap-face"}] }},
  "auth": {"headers": {"Authorization": "Bearer {{ api_key }}"}},
  "inputs": {"target": {"source": "first_reference_image", "encoding": "dreamapi_url", "required": true}, "face": {"source": "second_reference_image", "encoding": "dreamapi_url", "required": true}},
  "submit": {"method": "POST", "url": "{{ base_url }}/api/async/swap_face", "body": {"url": "{{ inputs.target }}", "faceImgUrl": "{{ inputs.face }}"}, "extract": {"task_id": ["$.data.taskId"], "error": ["$.message", "$.data.message"]}},
  "poll": {"method": "POST", "url": "{{ base_url }}/api/getAsyncResult", "body": {"taskId": "{{ task_id }}"}, "extract": {"status": {"paths": ["$.data.task.status"], "accept": "scalar"}, "image_url": ["$.data.images[0].imageUrl"], "error": ["$.data.task.reason", "$.data.task.error", "$.message"]}},
  "status_map": {"0": "queued", "1": "running", "2": "running", "3": "succeeded", "4": "failed"},
  "capabilities": {"image_to_image": true, "max_reference_images": 2}
}
